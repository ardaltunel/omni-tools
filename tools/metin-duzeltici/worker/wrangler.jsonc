{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omni-tools-text-corrector",
  "account_id": "b1a0c404a59941b8cc0fcf380b863f55",
  "main": "src/index.js",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "TEXT_RATE_LIMITER",
      "namespace_id": "1201",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://ardaltunel.github.io,http://localhost:8765,http://127.0.0.1:8765,null",
    "AI_TEXT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_TIMEOUT_MS": "45000",
    "AI_MAX_OUTPUT_TOKENS": "4000"
  }
}
