{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omni-tools-omni-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ai": {
    "binding": "AI"
  },
  "secrets": {
    "required": ["OPENAI_API_KEY"]
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1301",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://ardaltunel.github.io,http://localhost:8765,http://127.0.0.1:8765,null",
    "OPENAI_CHAT_MODEL": "gpt-5.6-luna",
    "OPENAI_MAX_OUTPUT_TOKENS": "1800",
    "WORKERS_AI_MODEL": "@cf/zai-org/glm-4.7-flash"
  }
}
